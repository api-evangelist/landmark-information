{
  "opencollection": "1.0.0",
  "info": {
    "name": "Order Experience API",
    "version": "1.3.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Order Experience API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Orders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.landmarkcloudservices.com/connect/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates orders associated with a transaction for the given products."
        },
        {
          "info": {
            "name": "Get Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.landmarkcloudservices.com/connect/orders/:orderId",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves an order with the given orderId."
        },
        {
          "info": {
            "name": "Get Order Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.landmarkcloudservices.com/connect/orders/:orderId/status",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the order status."
        },
        {
          "info": {
            "name": "Download Document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.landmarkcloudservices.com/connect/orders/:orderId/documents/:documentId",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              },
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Downloads a results document for an order."
        },
        {
          "info": {
            "name": "Override AML Result Section",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.landmarkcloudservices.com/connect/orders/:orderId/results/override-aml-section",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Overrides a result section of an AML order from a 'Refer' to a 'Pass'."
        }
      ]
    }
  ],
  "bundled": true
}